  },
  "dependencies": {
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  }
