{
  "name": "@opencollab/ui",
  "version": "0.1.0",
  "description": "Componentes visuales compartidos de OpenCollab (sin negocio, sin dependencias de Tauri ni xterm).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
