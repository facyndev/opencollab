{
  "name": "@opencollab/contracts",
  "version": "0.1.0",
  "description": "Wire contract de OpenCollab (única fuente del protocolo Envelope/Message): schemas zod + tipos inferidos + PROTOCOL_VERSION + errores.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
