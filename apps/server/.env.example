# Local dev database (see ../../docker-compose.yml).
DATABASE_URL=postgresql://opencollab:opencollab@localhost:5432/opencollab

# Required. At least 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# Base URL the browser reaches this server at (OAuth redirect URIs).
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional OAuth providers: a provider without both values is disabled (404).
# Callback URL to register: <PUBLIC_BASE_URL>/auth/oauth/<github|google>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
