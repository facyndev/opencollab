# ==============================================================================
# Variables de entorno de OpenCollab (Docker, Servidor/API, Web y Desktop)
# ==============================================================================
# Copiar a `.env` (archivo ignorado por git).
#
# Para `docker compose up -d --build`, todas las variables no comentadas son
# OBLIGATORIAS. Si falta alguna, el contenedor de la API no arranca
# (`docker compose logs api` indicará cuál falta).
# ==============================================================================

# --- Autenticación y Seguridad (API / Relay) ---
# Secreto para firmar tokens JWT (mínimo 32 caracteres). Generar por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=

# --- Proveedores OAuth (API / Relay) ---
# Credenciales OAuth de GitHub y Google. Callbacks a registrar en cada proveedor:
#   <PUBLIC_BASE_URL>/auth/oauth/github/callback
#   <PUBLIC_BASE_URL>/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs de Web, API y Desktop ---
# Origen de la aplicación web:
#   - En Docker (Nginx): http://localhost:8080
#   - En desarrollo local con Vite: http://localhost:1421
# La API lo usa para redirigir tras el login web, y el Desktop lo usa para abrir el navegador en Sign In.
WEB_ORIGIN=http://localhost:8080

# URL pública de la API donde se reciben los callbacks de OAuth:
#   - En Docker (Nginx proxea /auth): http://localhost:8080
#   - En desarrollo local sin proxy: http://127.0.0.1:8787
PUBLIC_BASE_URL=http://localhost:8080

# (Opcional) Sobrescribe el origen de la web EXCLUSIVAMENTE para la app de Desktop.
# Si no está definida, el Desktop usa WEB_ORIGIN o por defecto http://localhost:1421.
#OPENCOLLAB_WEB_ORIGIN=http://localhost:8080

# Dirección donde escucha el servidor Relay (API) y donde conecta el Desktop.
#   - Por defecto en desarrollo local: 127.0.0.1:8787
#   - En Docker Compose se configura en 0.0.0.0:8787 y se publica en 127.0.0.1:8787.
#RELAY_ADDR=127.0.0.1:8787

# (Opcional) Dirección del relay para el proxy de desarrollo de `apps/web` (Vite).
# Por defecto: http://127.0.0.1:8787
#OPENCOLLAB_API=http://127.0.0.1:8787

# --- Base de Datos PostgreSQL ---
# En Docker Compose se configura automáticamente apuntando al servicio `postgres`.
# Si corres la API standalone fuera de Docker, descomentar y configurar:
#DATABASE_URL=postgresql://opencollab:opencollab@127.0.0.1:5432/opencollab

# --- Reverse Proxy ---
# Configuración `trust proxy` de Express (opcional):
#   - En Docker (detrás de Nginx): 1
#   - En desarrollo directo: false
#TRUST_PROXY=1
