# Variables de `docker compose up -d --build`. Copiar a `.env` (ignorado por git).
# Todas las no comentadas son OBLIGATORIAS: si falta alguna, el server no arranca
# (`docker compose logs server` dice cuál).

# Mínimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_SECRET=

# OAuth de GitHub y Google. Callback a registrar en cada proveedor:
#   <PUBLIC_BASE_URL>/auth/oauth/github/callback
#   <PUBLIC_BASE_URL>/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origen público de la web y base de los callbacks de OAuth. Deben coincidir con
# la URL desde donde se abre la web.
#WEB_ORIGIN=http://localhost:8080
#PUBLIC_BASE_URL=http://localhost:8080
